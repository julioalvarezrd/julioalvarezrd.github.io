---
import '../styles/global.css';
const ig='https://instagram.com/julioalvarezrd';
---
<!doctype html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Portafolio profesional de Julio Alvarez, Ingeniero de Sistemas Computacionales especializado en infraestructura, redes, servidores y soluciones tecnológicas." />
  <link rel="icon" type="image/svg+xml" href="/ja-icon.svg" />
  <title>Julio Alvarez · Portafolio Profesional</title>
</head>
<body>
<header class="site-header">
  <a class="brand" href="#top"><img class="brand-mark" src="/ja-icon.svg" alt="JA" /><span class="brand-name">Julio Alvarez</span></a>
  <nav class="desktop-nav">
    <a href="#about" data-es="Sobre mí" data-en="About">Sobre mí</a>
    <a href="#expertise" data-es="Experiencia" data-en="Expertise">Experiencia</a>
    <a href="#projects" data-es="Proyectos" data-en="Projects">Proyectos</a>
    <a href="#contact" data-es="Contacto" data-en="Contact">Contacto</a>
  </nav>
  <div class="header-actions">
    <button id="lang-toggle" class="header-btn" aria-label="Cambiar idioma">EN</button>
    <button id="theme-toggle" class="header-btn" aria-label="Cambiar tema">◐</button>
    <button id="menu-toggle" class="menu-btn" aria-label="Abrir menú" aria-expanded="false">☰</button>
  </div>
</header>
<div id="mobile-menu" class="mobile-menu" aria-hidden="true">
  <a href="#about" data-es="Sobre mí" data-en="About">Sobre mí</a>
  <a href="#expertise" data-es="Experiencia" data-en="Expertise">Experiencia</a>
  <a href="#projects" data-es="Proyectos" data-en="Projects">Proyectos</a>
  <a href="#contact" data-es="Contacto" data-en="Contact">Contacto</a>
</div>

<main id="top">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow" data-es="Ingeniero de Sistemas Computacionales · República Dominicana" data-en="Computer Systems Engineer · Dominican Republic">Ingeniero de Sistemas Computacionales · República Dominicana</p>
      <h1 data-es="Infraestructura, tecnología y soluciones que funcionan." data-en="Infrastructure, technology and solutions that work.">Infraestructura, tecnología y soluciones que funcionan.</h1>
      <p class="hero-lead" data-es="Soy Julio Alvarez. Trabajo con redes, servidores, infraestructura tecnológica, soporte, CCTV, domótica, impresión 3D y soluciones digitales." data-en="I'm Julio Alvarez. I work across networking, servers, IT infrastructure, support, CCTV, home automation, 3D printing and digital solutions.">Soy Julio Alvarez. Trabajo con redes, servidores, infraestructura tecnológica, soporte, CCTV, domótica, impresión 3D y soluciones digitales.</p>
      <div class="hero-actions">
        <a class="btn primary" href="#projects" data-es="Ver proyectos" data-en="View projects">Ver proyectos</a>
        <a class="btn secondary" href={ig} target="_blank" rel="noreferrer">Instagram ↗</a>
      </div>
      <div class="hero-meta">
        <span>Networking</span><span>Servers</span><span>Linux</span><span>CCTV</span><span>Automation</span><span>3D Printing</span>
      </div>
    </div>
    <aside class="profile-card">
      <img src="https://avatars.githubusercontent.com/u/20918278?v=4" alt="Julio Alvarez" />
      <div class="profile-info">
        <div><strong>Julio Alvarez</strong><span data-es="Ingeniero de Sistemas Computacionales" data-en="Computer Systems Engineer">Ingeniero de Sistemas Computacionales</span></div>
        <span class="availability" data-es="Disponible para proyectos" data-en="Available for projects">Disponible para proyectos</span>
      </div>
    </aside>
  </section>

  <section id="about" class="section shell about-section">
    <div class="section-heading">
      <p class="section-kicker" data-es="Sobre mí" data-en="About me">Sobre mí</p>
      <h2 data-es="Un perfil técnico con enfoque práctico." data-en="A technical profile with a practical approach.">Un perfil técnico con enfoque práctico.</h2>
    </div>
    <div class="about-grid">
      <p data-es="Mi trabajo se mueve entre infraestructura, redes, servidores y soporte tecnológico. Me interesa resolver problemas reales, diseñar soluciones claras y mantener la tecnología simple, estable y útil." data-en="My work spans infrastructure, networking, servers and IT support. I focus on solving real problems, designing clear solutions and keeping technology simple, stable and useful.">Mi trabajo se mueve entre infraestructura, redes, servidores y soporte tecnológico. Me interesa resolver problemas reales, diseñar soluciones claras y mantener la tecnología simple, estable y útil.</p>
      <p data-es="También exploro áreas como CCTV, domótica, impresión 3D y desarrollo asistido por inteligencia artificial para ampliar las posibilidades de cada proyecto." data-en="I also explore areas such as CCTV, home automation, 3D printing and AI-assisted development to expand what each project can achieve.">También exploro áreas como CCTV, domótica, impresión 3D y desarrollo asistido por inteligencia artificial para ampliar las posibilidades de cada proyecto.</p>
    </div>
  </section>

  <section id="expertise" class="section shell">
    <div class="section-heading compact">
      <p class="section-kicker" data-es="Experiencia" data-en="Expertise">Experiencia</p>
      <h2 data-es="Áreas en las que aporto valor." data-en="Where I add value.">Áreas en las que aporto valor.</h2>
    </div>
    <div class="expertise-grid">
      <article><span>01</span><h3 data-es="Infraestructura & Servidores" data-en="Infrastructure & Servers">Infraestructura & Servidores</h3><p data-es="Configuración, virtualización y administración de servicios y entornos tecnológicos." data-en="Configuration, virtualization and administration of services and technology environments.">Configuración, virtualización y administración de servicios y entornos tecnológicos.</p></article>
      <article><span>02</span><h3 data-es="Redes" data-en="Networking">Redes</h3><p data-es="Diseño, configuración, mantenimiento y diagnóstico de redes." data-en="Network design, configuration, maintenance and troubleshooting.">Diseño, configuración, mantenimiento y diagnóstico de redes.</p></article>
      <article><span>03</span><h3 data-es="Soporte Tecnológico" data-en="IT Support">Soporte Tecnológico</h3><p data-es="Diagnóstico e implementación de soluciones para hogares, negocios y organizaciones." data-en="Diagnosis and implementation of solutions for homes, businesses and organizations.">Diagnóstico e implementación de soluciones para hogares, negocios y organizaciones.</p></article>
      <article><span>04</span><h3 data-es="CCTV & Domótica" data-en="CCTV & Home Automation">CCTV & Domótica</h3><p data-es="Videovigilancia, automatización e integración de tecnología en espacios físicos." data-en="Video surveillance, automation and technology integration in physical spaces.">Videovigilancia, automatización e integración de tecnología en espacios físicos.</p></article>
      <article><span>05</span><h3 data-es="Soluciones Digitales" data-en="Digital Solutions">Soluciones Digitales</h3><p data-es="Aplicaciones y herramientas construidas con tecnologías modernas y desarrollo asistido por IA." data-en="Applications and tools built with modern technologies and AI-assisted development.">Aplicaciones y herramientas construidas con tecnologías modernas y desarrollo asistido por IA.</p></article>
      <article><span>06</span><h3 data-es="Impresión 3D" data-en="3D Printing">Impresión 3D</h3><p data-es="Diseño y fabricación digital a través de 3DCow." data-en="Design and digital fabrication through 3DCow.">Diseño y fabricación digital a través de 3DCow.</p></article>
    </div>
  </section>

  <section id="projects" class="section shell projects-section">
    <div class="section-heading compact">
      <p class="section-kicker" data-es="Proyectos" data-en="Projects">Proyectos</p>
      <h2 data-es="Proyectos seleccionados." data-en="Selected projects.">Proyectos seleccionados.</h2>
    </div>
    <div class="project-grid">
      <article class="project-card featured">
        <div class="project-header"><span class="project-type" data-es="Sistema de gestión operativa" data-en="Operational management system">Sistema de gestión operativa</span><span>01</span></div>
        <div class="project-body"><h3>SIBOR</h3><p data-es="Plataforma orientada a centralizar personal, recursos, operaciones e incidencias para organizaciones de respuesta a emergencias." data-en="A platform focused on centralizing personnel, resources, operations and incidents for emergency-response organizations.">Plataforma orientada a centralizar personal, recursos, operaciones e incidencias para organizaciones de respuesta a emergencias.</p><div class="project-tags"><span>Next.js</span><span>PostgreSQL</span><span>Prisma</span></div></div>
      </article>
      <article class="project-card"><div class="project-header"><span class="project-type" data-es="Mercado laboral" data-en="Labor market">Mercado laboral</span><span>02</span></div><div class="project-body"><h3>Tu Salario RD</h3><p data-es="Proyecto digital enfocado en salarios, ingresos e información laboral relevante para República Dominicana." data-en="A digital project focused on salaries, income and relevant labor-market information for the Dominican Republic.">Proyecto digital enfocado en salarios, ingresos e información laboral relevante para República Dominicana.</p></div></article>
      <article class="project-card"><div class="project-header"><span class="project-type" data-es="Propiedades" data-en="Properties">Propiedades</span><span>03</span></div><div class="project-body"><h3 data-es="Gestión de Alquileres" data-en="Rental Management">Gestión de Alquileres</h3><p data-es="Solución en desarrollo para administrar propiedades residenciales y comerciales, contratos, pagos e inquilinos." data-en="A solution in development for managing residential and commercial properties, contracts, payments and tenants.">Solución en desarrollo para administrar propiedades residenciales y comerciales, contratos, pagos e inquilinos.</p></div></article>
      <article class="project-card"><div class="project-header"><span class="project-type" data-es="Fabricación digital" data-en="Digital fabrication">Fabricación digital</span><span>04</span></div><div class="project-body"><h3>3DCow</h3><p data-es="Emprendimiento de impresión 3D donde combino tecnología, diseño y fabricación digital para convertir ideas en objetos físicos." data-en="A 3D-printing venture combining technology, design and digital fabrication to turn ideas into physical objects.">Emprendimiento de impresión 3D donde combino tecnología, diseño y fabricación digital para convertir ideas en objetos físicos.</p></div></article>
    </div>
  </section>

  <section id="contact" class="section shell contact-section">
    <div>
      <p class="section-kicker" data-es="Contacto" data-en="Contact">Contacto</p>
      <h2 data-es="¿Tienes un proyecto o necesitas una solución tecnológica?" data-en="Have a project or need a technology solution?">¿Tienes un proyecto o necesitas una solución tecnológica?</h2>
    </div>
    <div class="contact-card"><p data-es="Hablemos de infraestructura, soporte, automatización, soluciones digitales o impresión 3D." data-en="Let's talk about infrastructure, support, automation, digital solutions or 3D printing.">Hablemos de infraestructura, soporte, automatización, soluciones digitales o impresión 3D.</p><a href={ig} target="_blank" rel="noreferrer">@julioalvarezrd ↗</a></div>
  </section>
</main>

<footer class="shell footer"><span>© 2026 Julio Alvarez</span><span data-es="Portafolio profesional" data-en="Professional portfolio">Portafolio profesional</span></footer>

<script is:inline>
const root=document.documentElement;
const themeButton=document.querySelector('#theme-toggle');
const langButton=document.querySelector('#lang-toggle');
const menuButton=document.querySelector('#menu-toggle');
const mobileMenu=document.querySelector('#mobile-menu');
root.dataset.theme=localStorage.getItem('theme')||'light';
themeButton.addEventListener('click',()=>{root.dataset.theme=root.dataset.theme==='light'?'dark':'light';localStorage.setItem('theme',root.dataset.theme);});
let lang=localStorage.getItem('lang')||'es';
const applyLanguage=()=>{root.lang=lang;document.querySelectorAll('[data-es][data-en]').forEach(el=>el.textContent=el.dataset[lang]);langButton.textContent=lang==='es'?'EN':'ES';};
applyLanguage();
langButton.addEventListener('click',()=>{lang=lang==='es'?'en':'es';localStorage.setItem('lang',lang);applyLanguage();});
const closeMenu=()=>{mobileMenu.classList.remove('open');menuButton.setAttribute('aria-expanded','false');mobileMenu.setAttribute('aria-hidden','true');menuButton.textContent='☰';};
menuButton.addEventListener('click',()=>{const open=!mobileMenu.classList.contains('open');mobileMenu.classList.toggle('open',open);menuButton.setAttribute('aria-expanded',String(open));mobileMenu.setAttribute('aria-hidden',String(!open));menuButton.textContent=open?'✕':'☰';});
mobileMenu.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));
</script>
</body>
</html>