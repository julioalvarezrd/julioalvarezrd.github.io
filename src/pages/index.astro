---
import '../styles/global.css';
const ig='https://instagram.com/julioalvarezrd';
---
<!doctype html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Julio Alvarez — Ingeniero de Sistemas Computacionales. Infraestructura, redes, servidores y soluciones tecnológicas." />
  <title>Julio Alvarez · Ingeniero de Sistemas Computacionales</title>
</head>
<body>
<header class="site-header">
  <a class="wordmark" href="#top">JULIO ALVAREZ</a>
  <nav class="desktop-nav">
    <a href="#about" data-es="Perfil" data-en="About">Perfil</a>
    <a href="#work" data-es="Trabajo" data-en="Work">Trabajo</a>
    <a href="#projects" data-es="Proyectos" data-en="Projects">Proyectos</a>
  </nav>
  <div class="header-actions">
    <button id="lang-toggle" class="text-btn">EN</button>
    <button id="theme-toggle" class="text-btn" aria-label="Cambiar tema">◐</button>
    <button id="menu-toggle" class="menu-btn" aria-label="Abrir menú" aria-expanded="false">MENU</button>
  </div>
</header>
<div id="mobile-menu" class="mobile-menu" aria-hidden="true">
  <a href="#about" data-es="Perfil" data-en="About">Perfil</a>
  <a href="#work" data-es="Trabajo" data-en="Work">Trabajo</a>
  <a href="#projects" data-es="Proyectos" data-en="Projects">Proyectos</a>
  <a href="#contact" data-es="Contacto" data-en="Contact">Contacto</a>
</div>

<main id="top">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow" data-es="Ingeniero de Sistemas Computacionales · República Dominicana" data-en="Computer Systems Engineer · Dominican Republic">Ingeniero de Sistemas Computacionales · República Dominicana</p>
      <h1>Julio<br />Alvarez</h1>
      <p class="intro" data-es="Trabajo entre infraestructura, redes, servidores y soluciones digitales. Me interesa convertir problemas complejos en sistemas simples, útiles y bien pensados." data-en="I work across infrastructure, networks, servers and digital solutions. I like turning complex problems into simple, useful and thoughtful systems.">Trabajo entre infraestructura, redes, servidores y soluciones digitales. Me interesa convertir problemas complejos en sistemas simples, útiles y bien pensados.</p>
      <div class="hero-links">
        <a href="#projects" data-es="Ver proyectos" data-en="View projects">Ver proyectos <span>↘</span></a>
        <a href={ig} target="_blank" rel="noreferrer">Instagram <span>↗</span></a>
      </div>
    </div>
    <figure class="portrait-card">
      <img src="https://avatars.githubusercontent.com/u/20918278?v=4" alt="Julio Alvarez" />
      <figcaption><span>Julio Alvarez</span><span>La Romana, RD</span></figcaption>
    </figure>
  </section>

  <section class="statement shell">
    <p data-es="Tecnología práctica, bien implementada y sin complicaciones innecesarias." data-en="Practical technology, implemented well and without unnecessary complexity.">Tecnología práctica, bien implementada y sin complicaciones innecesarias.</p>
  </section>

  <section id="about" class="split-section shell">
    <div class="section-tag">01 / <span data-es="PERFIL" data-en="ABOUT">PERFIL</span></div>
    <div class="section-copy">
      <h2 data-es="No me define una sola herramienta." data-en="I'm not defined by one tool.">No me define una sola herramienta.</h2>
      <p data-es="Soy Ingeniero de Sistemas Computacionales. Mi trabajo e intereses abarcan infraestructura, redes, servidores, soporte tecnológico, CCTV, domótica, impresión 3D y desarrollo de soluciones digitales apoyadas por inteligencia artificial." data-en="I'm a Computer Systems Engineer. My work and interests span infrastructure, networks, servers, IT support, CCTV, home automation, 3D printing and AI-assisted digital solutions.">Soy Ingeniero de Sistemas Computacionales. Mi trabajo e intereses abarcan infraestructura, redes, servidores, soporte tecnológico, CCTV, domótica, impresión 3D y desarrollo de soluciones digitales apoyadas por inteligencia artificial.</p>
    </div>
  </section>

  <section id="work" class="work-section shell">
    <div class="section-tag">02 / <span data-es="LO QUE HAGO" data-en="WHAT I DO">LO QUE HAGO</span></div>
    <div class="work-list">
      <article><span>Infraestructura</span><p data-es="Servidores, virtualización, servicios y administración tecnológica." data-en="Servers, virtualization, services and technology administration.">Servidores, virtualización, servicios y administración tecnológica.</p></article>
      <article><span data-es="Redes" data-en="Networking">Redes</span><p data-es="Diseño, configuración, mantenimiento y diagnóstico." data-en="Design, configuration, maintenance and troubleshooting.">Diseño, configuración, mantenimiento y diagnóstico.</p></article>
      <article><span data-es="Soporte" data-en="IT Support">Soporte</span><p data-es="Soluciones prácticas para hogares, negocios y organizaciones." data-en="Practical solutions for homes, businesses and organizations.">Soluciones prácticas para hogares, negocios y organizaciones.</p></article>
      <article><span>CCTV / Domótica</span><p data-es="Seguridad, automatización e integración de espacios." data-en="Security, automation and connected spaces.">Seguridad, automatización e integración de espacios.</p></article>
      <article><span data-es="Soluciones digitales" data-en="Digital solutions">Soluciones digitales</span><p data-es="Aplicaciones y herramientas creadas con tecnologías modernas e IA." data-en="Apps and tools built with modern technology and AI.">Aplicaciones y herramientas creadas con tecnologías modernas e IA.</p></article>
      <article><span>3DCow</span><p data-es="Diseño e impresión 3D para convertir ideas en objetos físicos." data-en="3D design and printing to turn ideas into physical objects.">Diseño e impresión 3D para convertir ideas en objetos físicos.</p></article>
    </div>
  </section>

  <section id="projects" class="projects-section shell">
    <div class="projects-title-row">
      <div class="section-tag">03 / <span data-es="PROYECTOS" data-en="PROJECTS">PROYECTOS</span></div>
      <h2 data-es="Algunas cosas que estoy construyendo." data-en="A few things I'm building.">Algunas cosas que estoy construyendo.</h2>
    </div>
    <div class="project-list">
      <a class="project-row" href="#"><span class="project-index">01</span><div><strong>SIBOR</strong><p data-es="Gestión operativa para organizaciones de respuesta a emergencias." data-en="Operational management for emergency-response organizations.">Gestión operativa para organizaciones de respuesta a emergencias.</p></div><span class="arrow">↗</span></a>
      <a class="project-row" href="#"><span class="project-index">02</span><div><strong>Tu Salario RD</strong><p data-es="Información y herramientas sobre salarios y mercado laboral dominicano." data-en="Salary and labor-market information for the Dominican Republic.">Información y herramientas sobre salarios y mercado laboral dominicano.</p></div><span class="arrow">↗</span></a>
      <a class="project-row" href="#"><span class="project-index">03</span><div><strong data-es="Gestión de Alquileres" data-en="Rental Management">Gestión de Alquileres</strong><p data-es="Plataforma para propiedades residenciales y comerciales." data-en="Platform for residential and commercial properties.">Plataforma para propiedades residenciales y comerciales.</p></div><span class="arrow">↗</span></a>
      <a class="project-row" href="#"><span class="project-index">04</span><div><strong>3DCow</strong><p data-es="Impresión 3D, diseño y fabricación digital." data-en="3D printing, design and digital fabrication.">Impresión 3D, diseño y fabricación digital.</p></div><span class="arrow">↗</span></a>
    </div>
  </section>

  <section id="contact" class="contact-section shell">
    <p class="section-tag">04 / <span data-es="CONTACTO" data-en="CONTACT">CONTACTO</span></p>
    <h2 data-es="¿Tienes algo que quieras mejorar, conectar o construir?" data-en="Have something you want to improve, connect or build?">¿Tienes algo que quieras mejorar, conectar o construir?</h2>
    <a href={ig} target="_blank" rel="noreferrer">@julioalvarezrd <span>↗</span></a>
  </section>
</main>

<footer class="shell footer"><span>© 2026 Julio Alvarez</span><span data-es="Ingeniero de Sistemas Computacionales" data-en="Computer Systems Engineer">Ingeniero de Sistemas Computacionales</span></footer>

<script is:inline>
const root=document.documentElement;
const themeButton=document.querySelector('#theme-toggle');
const langButton=document.querySelector('#lang-toggle');
const menuButton=document.querySelector('#menu-toggle');
const mobileMenu=document.querySelector('#mobile-menu');
root.dataset.theme=localStorage.getItem('theme')||'light';
themeButton.addEventListener('click',()=>{root.dataset.theme=root.dataset.theme==='light'?'dark':'light';localStorage.setItem('theme',root.dataset.theme);});
let lang=localStorage.getItem('lang')||'es';
const applyLanguage=()=>{root.lang=lang;document.querySelectorAll('[data-es][data-en]').forEach(el=>el.textContent=el.dataset[lang]);langButton.textContent=lang==='es'?'EN':'ES';};
applyLanguage();
langButton.addEventListener('click',()=>{lang=lang==='es'?'en':'es';localStorage.setItem('lang',lang);applyLanguage();});
const closeMenu=()=>{mobileMenu.classList.remove('open');menuButton.setAttribute('aria-expanded','false');mobileMenu.setAttribute('aria-hidden','true');};
menuButton.addEventListener('click',()=>{const open=!mobileMenu.classList.contains('open');mobileMenu.classList.toggle('open',open);menuButton.setAttribute('aria-expanded',String(open));mobileMenu.setAttribute('aria-hidden',String(!open));menuButton.textContent=open?'CLOSE':'MENU';});
mobileMenu.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));
</script>
</body>
</html>